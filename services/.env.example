# Scotri services — environment template
#
# Copy this file to `.env` (already gitignored) and fill in real values
# locally for development/testing. NEVER commit a real .env file, and never paste real values into
# chat, a ticket, or any file this agent writes.
#
# Phase 1 (now): plain environment variables, sourced from this file via a local .env loader.
# Phase 2 (later): swap for Azure Key Vault — the SecretProvider port means this is an adapter swap,
# not a rewrite. See services/README.md once it exists for the port/adapter layout.

# ── Databricks (service-principal M2M OAuth) ────────────────────────────────────────────────
# Grants required: SELECT-only on <prod_catalog> and <dev_catalog>; CAN USE on the configured SQL warehouse.
DATABRICKS_HOST=""                     # e.g. https://<databricks host>
DATABRICKS_CLIENT_ID=""                # service-principal application (client) id
DATABRICKS_CLIENT_SECRET=""            # service-principal client secret
DATABRICKS_SQL_WAREHOUSE_ID=""         # this deployment's warehouse id — do not assume another deployment's

# ── Azure DevOps (read-only PAT — sync service uses this to refresh the mirror) ─────────────
# Scope: Code (Read) ONLY. Never a PAT with Code (Read & Write) or higher — see
# agent-instructions.md: no write-capable git credential exists anywhere in this deployment.
#
# A PAT is scoped to one ADO org. When the registry spans several orgs, ADO_PAT_READONLY_<ORG>
# overrides ADO_PAT_READONLY for that one org (see adapters/ado_auth.py for the name-normalization
# rule: non-alphanumeric -> "_", uppercased — e.g. org "Contoso-BI" -> ADO_PAT_READONLY_CONTOSO_BI).
# `python -m app.setup secrets` asks for one per org in client/profile.yaml.
ADO_PAT_READONLY=""                              # the first (or only) ADO org

# ── Fabric / Power BI (service-principal, XMLA + REST) ──────────────────────────────────────
FABRIC_SP_CLIENT_ID=""                 # service-principal application id
FABRIC_SP_CLIENT_SECRET=""             # service-principal client secret
FABRIC_TENANT_ID=""                   # Fabric/PBI (BI) tenant — may differ from the ADO/ADF/Databricks (data) tenant

# ── Azure Data Factory run history (federated credential, NO secret) ─────────────────────────
# ADF can live in a different Entra tenant (the data tenant) from Fabric/Scotri. The app below
# trusts a user-assigned managed identity on the Scotri host via a federated identity credential
# (issuer https://login.microsoftonline.com/<Fabric tenant>/v2.0, subject = the identity's object id,
# audience api://AzureADTokenExchange). It needs Reader on each factory in config/adf_factories.yaml
# (OPEN_ITEMS.md #16). None of these values is a secret. Works only on an Azure host that has the
# identity attached, or where a token file is projected (AKS) — not on a laptop.
ADF_TENANT_ID=""                      # the data tenant
ADF_CLIENT_ID=""                      # that tenant's app registration's application id
ADF_MANAGED_IDENTITY_OBJECT_ID=        # object (principal) id of the Scotri host's user-assigned identity
ADF_FEDERATED_TOKEN_FILE=              # AKS workload identity only: path of the projected token file

# ── Jira / Atlassian (service account, plain REST, no OAuth MCP) ────────────────────────────
# JIRA_BASE_URL is the site itself, used only to resolve JIRA_CLOUD_ID (via the unauthenticated
# /_edge/tenant_info endpoint) — actual REST calls go through the Atlassian API gateway
# (api.atlassian.com/ex/jira/<cloudId>/...), NOT this URL directly, because the token in use here
# is a SCOPED API token, not a classic one — confirmed 2026-09-22 after a real 401 against the
# site URL directly. See adapters/jira/api_base.py.
JIRA_BASE_URL=""                      # e.g. https://yourcompany.atlassian.net (setup secrets fills it from the profile)
JIRA_CLOUD_ID=""                       # curl https://<site>.atlassian.net/_edge/tenant_info (no auth needed)
JIRA_EMAIL=""                          # account email
JIRA_API_TOKEN=""                      # scoped Atlassian API token — needs at least read:jira-work, read:jira-user, read:me

# One Jira account serves both reading and the narrow jira-write exception (comment, edit-own-comment,
# create-Bug ONLY), so the token above also needs write:jira-work. The confirm-before-submit gate in
# app/cli.py is the only thing enforcing jira-write's scope — see .claude/skills/jira-write/SKILL.md.

# ── Redis (shared coordination store: query governor + presence-claim + maintenance flag) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""                    # leave blank for a local dev instance with no auth
REDIS_USE_TLS=false                  # set true once pointed at a managed/production Redis

# ── Mirror / sync service ───────────────────────────────────────────────────────────────────
# Relative paths in this file (MIRROR_ROOT, *_PATH, *_DIR, DOCS_AI_ROOT) resolve under services/, not
# the directory a process was started from (OPEN_ITEMS.md #62).
MIRROR_ROOT=./mirror                 # parent of mirror-active/ and mirror-staging/
SYNC_SCHEDULE_CRON=0 3 * * *          # default: once daily, 03:00 — low-traffic hours
# Advisory staleness threshold for mirror reads (OPEN_ITEMS.md #31): mirror-list/mirror-read warn
# (but never refuse) when the last sync is older than this. Default 90000s (25h) = one daily cycle
# plus grace. Never blocks a read — it makes an old-but-idle mirror visible.
MIRROR_STALE_WARN_SECONDS=90000

# ── LLM host (Claude Agent SDK, via app/api.py) ─────────────────────────────────────────────
# One model (Claude Sonnet 5.5, `claude-sonnet-5-5`) and this one key for every lifecycle stage —
# decided 2026-10-07, OPEN_ITEMS.md #4. The model is set in services/config/model_registry.yaml
# (see docs/ai/model-registry.md), not here.
ANTHROPIC_API_KEY=""                   # Anthropic API key for the Agent SDK host process

# ── Azure AD (Entra ID) — end-user auth across every frontend (OPEN_ITEMS.md, 2026-09-22) ──
# This API is ONE app registration; every frontend (Teams, a web portal, ...) is its OWN app
# registration acquiring a token for THIS audience. Platform is read from the token's own appid/azp
# claim, never a self-reported header. Open sub-decision (see OPEN_ITEMS.md): whether this tenant is
# the same one Fabric uses (FABRIC_TENANT_ID above) or a separate one — do not assume either way.
# REQUIRED, not optional (adapters/azure_ad/token_validator.py reads both via secrets.get(), not
# get_optional()) — app/api.py's /v1/chat endpoints will fail to build the container until both are
# filled in with real values.
# AZURE_AD_TENANT_ID: the Entra tenant issuing tokens this API accepts
AZURE_AD_TENANT_ID=
# AZURE_AD_API_AUDIENCE: this API's own app registration's Application ID URI / client id
AZURE_AD_API_AUDIENCE=

# ── Dev/testing auth bypass (app/container.py, added 2026-09-25) ───────────────────────────
# SCOTRI_AUTH_MODE=dev swaps container.identity_provider for StaticIdentityProvider (no Entra
# call, AZURE_AD_TENANT_ID/AZURE_AD_API_AUDIENCE not needed) — LOCAL/TEST-FRONTEND USE ONLY.
# Leave unset (or anything other than "dev") in every real deployment; the default is the real
# AzureAdIdentityProvider. A test frontend must still send an Authorization: Bearer <token> header
# where <token> equals SCOTRI_DEV_AUTH_TOKEN exactly — this is a shared dev secret, not a real JWT,
# and is compared with a constant-time check (adapters/dev_auth/static_identity_provider.py).
# NOTE: keep these on their own line with nothing after the value — python-dotenv treats a
# trailing "# comment" on the SAME line as an empty/short value as part of the value, not a
# comment, so an inline comment here silently corrupts SCOTRI_AUTH_MODE/SCOTRI_DEV_AUTH_TOKEN.
SCOTRI_AUTH_MODE=
# required when SCOTRI_AUTH_MODE=dev; pick any local secret string, e.g. `openssl rand -hex 32`
SCOTRI_DEV_AUTH_TOKEN=
# optional, defaults to "dev-user"
SCOTRI_DEV_PRINCIPAL_SUBJECT=
# optional, defaults to "Dev User"
SCOTRI_DEV_PRINCIPAL_NAME=
# optional, defaults to "dev-frontend" (domain/models.py Principal.platform)
SCOTRI_DEV_PRINCIPAL_PLATFORM=
# optional, comma-separated, defaults to none
SCOTRI_DEV_PRINCIPAL_ROLES=

# ── Interaction log (app/api.py) ────────────────────────────────────────────────────────────
# JSONL, one line per completed/failed engagement — decided 2026-09-23, matches this project's
# existing "logs + a status file, no DB yet" precedent (see mirror/status.json).
INTERACTION_LOG_PATH=./logs/interaction-log.jsonl
# Folder for the scotri-*.log files (cli/api/mcp/sync). Empty = ./logs under services/. The test
# suite points it at a temp folder so pytest never writes the real audit trail (OPEN_ITEMS.md #56).
SCOTRI_LOG_DIR=

# ── Engagement job store (app/api.py, Redis-backed) ─────────────────────────────────────────
JOB_TTL_SECONDS=86400                # how long a finished engagement's record survives in Redis
ENGAGEMENT_TIMEOUT_SECONDS=1200      # wall-clock ceiling per engagement run (OPEN_ITEMS.md #33);
                                     # default 20 min. On expiry the run is stopped and reported as
                                     # a non-success outcome (is_error+incomplete), never a hang.
ENGAGEMENT_MAX_TURNS=150             # agent turns per run (#33); the largest run measured took 43.
                                     # 0 = no limit. A run that hits it ends incomplete.
# ENGAGEMENT_MAX_BUDGET_USD=          # model cost ceiling per run (#33); unset = none. Set it from the
                                     # "usage: turns=… cost_usd=…" lines in scotri-api.log after a week.
# Engagement queue (OPEN_ITEMS.md #32): how many run at once across the API and MCP processes;
# the rest wait in one FIFO queue in Redis and start when a slot frees up.
MAX_CONCURRENT_ENGAGEMENTS=4          # runs at once, per deployment: each is a Claude CLI process
                                     # (160-320 MB each on this host), and extra runs just queue at the governor
MAX_QUEUED_ENGAGEMENTS_PER_USER=3     # waiting jobs per caller; more is refused with 429
ENGAGEMENT_QUEUE_MAX_WAIT_SECONDS=1800 # a job waiting longer is cancelled (cancel_reason queue_timeout)
ENGAGEMENT_QUEUE_MAX_LENGTH=30        # a full queue refuses new jobs with 503
# Query governor (OPEN_ITEMS.md #3): per-user governed calls per clock hour (across every backend;
# cache hits are free, refused calls count) and in-flight calls per backend. Values below are the
# recommended ones, measured 2026-10-08; omit a line to fall back to the code default (30 / 5).
GOVERNOR_RATE_LIMIT_PER_USER_PER_HOUR=150 # the heaviest run seen used 31; ~2 full lifecycles + retries
GOVERNOR_MAX_CONCURRENT=5             # every backend; GOVERNOR_MAX_CONCURRENT_<BACKEND> overrides one
                                      # (DATABRICKS, FABRIC, ADO, ADF, JIRA)
GOVERNOR_MAX_CONCURRENT_DATABRICKS=8  # a batch runs 4 at once: two engagements batching don't queue
GOVERNOR_MAX_CONCURRENT_FABRIC=3      # DAX/refresh reads share the Fabric capacity with real users
# MIRROR_TEXT_CACHE_DIR=data/mirror-text-cache  # mirror-grep's per-tree text cache (#46): ~430 MB for
                                     # every tree, rebuilt by every sync right after its swap
# Grounding check (OPEN_ITEMS.md #68, domain/grounding.py): numbers, table and file names in a finished
# answer that appear in none of the run's tool results go back to the agent once to verify or label.
GROUNDING_CHECK=on                    # off disables it
# Windows only, optional: Git Bash for the engagement's Bash tool. Leave unset and the adapter finds
# it (the `git` on PATH, Scoop, Program Files); set it if Git is installed somewhere else. Without
# Git Bash an engagement is stopped at start with an error (see services/README.md, "Running").
CLAUDE_CODE_GIT_BASH_PATH=

# ── Durable engagement history + conversations (app/api.py, OPEN_ITEMS.md #19/#25) ──────────
# The durable system-of-record for per-user history and server-side conversations, beyond the
# 24h job store above. SQLite for local/dev; on Azure AKS this swaps to a managed DB (Azure SQL /
# PostgreSQL) behind ports/engagement_history.py — a pod's local disk is ephemeral and not shared
# across replicas. All optional (sensible defaults); shown here for completeness.
ENGAGEMENT_HISTORY_DB_PATH=./data/history.db     # dev SQLite path (gitignored under services/data/)
# Roles allowed to read ANOTHER user's conversation/history (GET /v1/conversations/{id}); empty =
# owner-only. e.g. HISTORY_ADMIN_ROLES=lead,admin. The still-open "relevant users" decision as a setting.
HISTORY_ADMIN_ROLES=

# ── Lineage graph + retrieval (OPEN_ITEMS.md #37/#38) ───────────────────────────────────────
# The lineage graph is a DERIVED, rebuildable SQLite index (fine as an ephemeral per-pod file on AKS,
# rebuilt from the YAML on startup) — unlike the history store above, it is not a system of record.
LINEAGE_DB_PATH=./data/lineage.db                        # derived index (gitignored under services/data/)
LINEAGE_SOURCE_PATH=../docs/ai/client/lineage-graph.yaml        # machine source of truth for the graph
DOCS_AI_ROOT=../docs/ai                                   # corpus root for `retrieve --scope docs`

# ── MCP server (app/mcp_server.py, raised 2026-09-24) ───────────────────────────────────────
# Scotri exposed as MCP tools (scotri_start/scotri_status) for a Claude/agent-client caller — a
# second transport for the same engagement engine app/api.py already exposes over HTTP, not a new
# credential surface. Reuses AZURE_AD_TENANT_ID/AZURE_AD_API_AUDIENCE above for auth and
# JOB_TTL_SECONDS/INTERACTION_LOG_PATH above for state. No new env vars needed today; add one here
# if the streamable-http port ever needs to be configurable rather than passed on the uvicorn CLI.

# ── Shared files and uploads (app/api.py, app/mcp_server.py, OPEN_ITEMS.md #6) ────────────────
# Where an engagement's markdown deliverables (intake, verdict, impact analysis, plan, test results,
# handoff, proposal patches) are published for GET /v1/engagements/{id}/files and the MCP
# scotri_list_files/scotri_get_file tools, and where POST /v1/uploads stores attachments.
#   local      — a folder on this machine (Mac/Windows; the default). Single-host only.
#   azure_blob — an Azure Blob container shared by every replica (Azure/Foundry). Needs
#                `pip install -r requirements-azure.txt`.
ARTIFACT_STORE=local
# local only; relative paths resolve under services/ (gitignored under services/data/)
ARTIFACT_STORE_DIR=./data/artifacts
# azure_blob only. Auth is non-interactive, first match wins:
#   1. a connection string (also how a local Azurite emulator is reached), else
#   2. ACCOUNT_URL + a service principal (TENANT_ID/CLIENT_ID/CLIENT_SECRET) with
#      "Storage Blob Data Contributor" on the container, else
#   3. ACCOUNT_URL alone = managed identity (MANAGED_IDENTITY_CLIENT_ID picks a user-assigned one).
# Sourced from a vault at runtime in a real deployment; never commit values.
ARTIFACT_STORE_AZURE_CONTAINER=scotri-artifacts
ARTIFACT_STORE_AZURE_CONNECTION_STRING=
ARTIFACT_STORE_AZURE_ACCOUNT_URL=
ARTIFACT_STORE_AZURE_TENANT_ID=
ARTIFACT_STORE_AZURE_CLIENT_ID=
ARTIFACT_STORE_AZURE_CLIENT_SECRET=
ARTIFACT_STORE_AZURE_MANAGED_IDENTITY_CLIENT_ID=
# Upload limits. Default extensions: text formats plus .pdf and common images (what the agent can
# actually read). Comma-separated to override, e.g. .md,.txt,.csv,.pdf
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_EXTENSIONS=
# Retention (OPEN_ITEMS.md #6(a)), in whole days; empty or 0 = keep forever (the default). Applied only
# when an operator runs `artifacts-purge --confirmed`. On Azure, set the same numbers as Blob
# lifecycle rules on the uploads/ and engagements/ prefixes instead.
UPLOAD_RETENTION_DAYS=
SHARED_FILE_RETENTION_DAYS=
# Roles allowed to read the files of an engagement someone else ran, on top of HISTORY_ADMIN_ROLES.
# Lets an implementer fetch a handoff doc without reading the whole conversation. Empty = owner-only.
FILE_READER_ROLES=
# Roles allowed to browse EVERY caller's learnings (GET /v1/learnings?scope=team, OPEN_ITEMS.md #60(d)).
# Empty = each caller browses only their own. The agent's own retrieve always searches all of them.
LEARNINGS_READER_ROLES=

# ── Admin panel (OPEN_ITEMS.md #43; /admin page, /v1/admin/* routes) ────────────────────────────
# Entra app role(s) allowed into the admin panel. Decided 2026-10-06: `scotri.admin`, an app role on
# the Scotri API's Entra app registration, assigned to the people who operate Scotri. Unset or empty
# means NOBODY (fail closed), never everyone. It does not imply HISTORY_ADMIN_ROLES or FILE_READER_ROLES.
# With SCOTRI_AUTH_MODE=dev, add scotri.admin to SCOTRI_DEV_PRINCIPAL_ROLES to open the panel locally.
ADMIN_ROLES=scotri.admin
# Every admin call, allowed or refused, is appended here as one JSON line (never the payload).
ADMIN_AUDIT_LOG_PATH=./logs/admin-audit.jsonl
